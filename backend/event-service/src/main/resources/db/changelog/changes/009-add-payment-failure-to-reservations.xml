<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Motif du refus de paiement (code Stripe : insufficient_funds, card_declined…),
        renseigné quand la saga annule une réservation parce que le paiement a échoué.
    -->
    <changeSet id="009-add-payment-failure-to-reservations" author="cyrine">
        <addColumn tableName="reservations">
            <column name="payment_failure_code" type="varchar(40)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="reservations" columnName="payment_failure_code"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
