<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Utilise par le batch d'expiration : recherche des reservations PENDING plus anciennes qu'un seuil -->
    <changeSet id="003-index-reservations-status-created-at" author="cyrine">
        <createIndex tableName="reservations" indexName="idx_reservations_status_created_at">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
