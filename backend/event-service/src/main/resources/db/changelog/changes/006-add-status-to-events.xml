<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Statut de l'événement (OPEN / CLOSED).
        Ici, une valeur par défaut suffit : Postgres remplit les lignes existantes avec OPEN,
        on peut donc poser NOT NULL directement (pas besoin des 3 étapes de 004/005).
    -->
    <changeSet id="006-add-status-to-events" author="cyrine">
        <addColumn tableName="events">
            <column name="status" type="varchar(10)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <sql>
            ALTER TABLE events
                ADD CONSTRAINT events_status_check
                CHECK (status IN ('OPEN', 'CLOSED'))
        </sql>

        <rollback>
            <dropColumn tableName="events" columnName="status"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
